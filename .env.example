# Local dev only — production credentials live in a secrets manager
# (Phase 9 §7), never in a checked-in .env file.

# db/platform
PLATFORM_DATABASE_URL=postgresql://school_os:school_os@localhost:5432/school_os_platform

# db/tenant — the M0 convenience tenant seeded by db/platform's seed
# script. Real tenants created via signup (Milestone 1) get their own
# database dynamically — see TENANT_DB_BASE_URL / POSTGRES_ADMIN_URL below.
TENANT_DATABASE_URL=postgresql://school_os:school_os@localhost:5432/school_os_tenant_greenvalley

# apps/worker's provisioning pipeline (Phase 9 §3, Milestone 1): the admin
# connection used to CREATE DATABASE, and the base URL new tenant database
# connection strings are built from. Local-dev-only naming scheme — a real
# deployment uses a managed provider's provisioning API instead (Phase 1
# §11 / Phase 9 §3), not raw CREATE DATABASE statements.
POSTGRES_ADMIN_URL=postgresql://school_os:school_os@localhost:5432/postgres
TENANT_DB_BASE_URL=postgresql://school_os:school_os@localhost:5432

# apps/api
PORT=4000
JWT_SECRET=dev-only-secret-change-me
ADMIN_JWT_SECRET=dev-only-admin-secret-change-me
FRONTEND_URL=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEV_TENANT=greenvalley

# apps/api + apps/worker — job queue (Phase 1 §11, Phase 9 §5)
REDIS_URL=redis://localhost:6379

# apps/api — AI homework generator (Milestone 5, Phase 9 §8). Optional:
# leave unset and the feature still works end-to-end using a deterministic
# template fallback (apps/api/src/services/ai/homeworkGenerator.ts) — set
# this to make it actually call Claude, no other code change needed.
# ANTHROPIC_API_KEY=
